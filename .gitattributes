# Shell scripts must use LF line endings even when checked out on Windows.
# Without this, Git Bash / WSL refuse to execute scripts ("/usr/bin/env: 'bash\r'").
*.sh           text eol=lf
*.bash         text eol=lf

# Python scripts: same reason, plus consistency.
*.py           text eol=lf

# PowerShell scripts: CRLF is the Windows-native convention and pwsh handles both,
# but pinning CRLF avoids noisy diffs when edited on Windows.
*.ps1          text eol=crlf
*.psm1         text eol=crlf
*.psd1         text eol=crlf

# Markdown / JSON / templates: let Git normalize to LF on commit, restore native on checkout.
*.md           text
*.json         text
*.csv          text

# Binary-ish things that should never be touched:
*.png          binary
*.jpg          binary
*.gif          binary
*.ico          binary
*.zip          binary
*.tar.gz       binary
